# /opt/billing/.env on the server (permissions 600, owned by root).
# setup-server.sh creates this file and fills the GENERATED values with random secrets.
# Never commit the real file.

# ── Web address ──────────────────────────────────────────────────────────────
APP_DOMAIN=billing.example.com
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=owner@example.com

# ── Generated on the server ──────────────────────────────────────────────────
POSTGRES_PASSWORD=GENERATED
APP_SECRET=GENERATED
# Encrypts point-in-time backups. COPY THIS INTO THE OWNER'S RECOVERY KIT.
PITR_CIPHER_PASS=GENERATED

# ── Oracle Object Storage (S3-compatible "Customer Secret Key") ─────────────
# Host looks like: <namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com
OCI_S3_HOST=
OCI_REGION=ap-mumbai-1
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
OCI_BUCKET_PITR=billing-pitr
OCI_BUCKET_SNAPSHOTS=billing-snapshots
OCI_BUCKET_ARCHIVE=billing-archive

# ── Google Drive copy (rclone remote "gdrive" in /opt/billing/secrets/rclone.conf) ──
GDRIVE_ENABLED=false
GDRIVE_FOLDER=BillingBackups

# ── Alerts ───────────────────────────────────────────────────────────────────
ALERT_EMAIL_TO=
# e.g. smtps://smtp.gmail.com:465 (use an app password, not your normal password)
SMTP_URL=
SMTP_USER=
SMTP_PASSWORD=
# Optional dead-man switch, e.g. https://hc-ping.com/<uuid> — alerts you if backups stop running
HEALTHCHECK_URL=
